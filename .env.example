# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Netsense portal credentials
NETSENSE_EMAIL=your@email.com
NETSENSE_PASSWORD=yourpassword

# Path where Playwright persists the authenticated session (also gitignored)
NETSENSE_STORAGE_STATE=.netsense_storage_state.json

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg://pollino:pollino@localhost:5432/pollino_dev
